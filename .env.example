# Vicious Suite — single shared config for all four tabs
# (Offline, Archi, Spark, Script all read this same key via src/lib/ai.ts)
#
# This key is called directly from the browser/WebView (no server), so it
# gets baked into the static JS bundle at build time. Anyone who unpacks the
# built app can extract it. That's a deliberate tradeoff for a standalone
# APK — rotate the key at https://console.groq.com/keys if that's ever an
# issue.
#
# NOTE the NEXT_PUBLIC_ prefix is required — Next.js only inlines env vars
# with that prefix into the client bundle. A plain GROQ_API_KEY here would
# NOT be visible to the app at all.

NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Optional — defaults to llama-3.3-70b-versatile if unset
NEXT_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
